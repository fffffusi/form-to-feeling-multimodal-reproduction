*==============================================================================
. * Part 0. 加载 + 标准化所有关键变量
. *==============================================================================
. use "data_anonymized/product_master.dta", clear

. display "样本数: " _N
样本数: 200

. 
. * 控制变量
. gen lnprice = ln(price + 1)

. gen lnreviews = ln(n_reviews_total + 1)

. 
. * 主分析样本标志
. gen included_main = (n_reviews_total >= 20)

. 
. * z-score 标准化(关键:让回归系数变成标准化 β,直接可比)
. foreach v in y_50_50 y_30_70 y_70_30 y_sentiment_only y_favrate_only ///
>              m_e_avg m_f_avg ///
>              z_pc1 z_pc2 z_pc3 z_pc4 z_pc5 z_pc6 z_pc7 ///
>              me1_z me2_z me3_z me4_z me5_z ///
>              mf1_z mf2_z mf3_z mf4_z mf5_z mf6_z mf7_z ///
>              lnprice lnreviews {
  2.     capture confirm variable `v'
  3.     if !_rc {
  4.         egen `v'_s = std(`v')
  5.     }
  6. }

. 
. * 变量标签
. label var y_50_50_s             "Y (50:50)"

. label var y_30_70_s             "Y (30:70)"

. label var y_70_30_s             "Y (70:30)"

. label var y_sentiment_only_s    "Y (sentiment only)"

. label var y_favrate_only_s      "Y (favrate only)"

. label var m_e_avg_s             "M_E (Kansei)"

. label var m_f_avg_s             "M_F (Function)"

. label var z_pc1_s "PC1 Minimalist Lightness"

. label var z_pc2_s "PC2 Refined Tech-Modern"

. label var z_pc3_s "PC3 Non-Lifting Premium"

. label var z_pc4_s "PC4 Heavy Rack Architecture"

. label var z_pc5_s "PC5 Dark Rough Texture"

. label var z_pc6_s "PC6 Leg-Style Variation"

. label var z_pc7_s "PC7 Light-Wood Accessory"

. label var lnprice_s "ln(Price)"

. label var lnreviews_s "ln(N_reviews)"

. 
. egen id = group(product_id)

. 
. save "data_anonymized/product_master.dta", replace
file data_anonymized/product_master.dta saved

. 
end of do-file

. do "<LOCAL_TEMP_DO_FILE>"

. 
. 
