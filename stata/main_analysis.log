. foreach v in lnprice_s lnreviews_s has_discount_s free_shipping_s ///
>              ln_imperfection_s ln_brand_avg_price_s recency_inv_s {
  2.     capture drop _vif_tmp
  3.     quietly reg `v' lnprice_s lnreviews_s has_discount_s free_shipping_s ///
>         ln_imperfection_s ln_brand_avg_price_s recency_inv_s
  4.     scalar _vif_val = 1 / (1 - e(r2))
  5.     scalar _vif_inv = 1 - e(r2)
  6.     local _flag = ""
  7.     if _vif_val >= 10 local _flag = "SEVERE(>=10)"
  8.     else if _vif_val >= 5 local _flag = "elevated(5-10)"
  9.     file write vif_fh "(a)controls,`v'," %9.4f (_vif_val) "," %9.4f (_vif_inv) ",`_flag'" _n
 10. }

