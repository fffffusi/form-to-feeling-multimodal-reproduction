. *==============================================================================
. * Part 4. Serial Mediation Path A: 视觉 → M_E → M_F → Y (Table 5A)
. *==============================================================================
. use "data_anonymized/product_master.dta", clear

. global X "z_pc1_s z_pc2_s z_pc3_s z_pc4_s z_pc5_s z_pc6_s z_pc7_s"

. global ME "m_e_avg_s"

. global MF "m_f_avg_s"

. global Y "y_50_50_s"

. global CTRL "lnprice_s lnreviews_s"

. 
. capture program drop serial_A

. program serial_A, rclass
  1.     * Path A: 美 (M_E) 影响 用 (M_F), 然后 M_F 影响 Y
.     sem ($ME <- $X $CTRL) ///
>         ($MF <- $X $ME $CTRL) ///
>         ($Y  <- $X $ME $MF $CTRL)
  2. 
.     scalar d_EF  = _b[$MF:$ME]      // M_E → M_F
  3.     scalar bF_A  = _b[$Y:$MF]       // M_F → Y (controlling M_E)
  4.     scalar bE_A  = _b[$Y:$ME]       // M_E → Y (direct, controlling M_F)
  5. 
.     * Serial indirect: a_E_i × d_EF × b_F (per PC)
.     forvalues i = 1/7 {
  6.         scalar aE`i' = _b[$ME:z_pc`i'_s]
  7.         return scalar serialA_pc`i' = aE`i' * d_EF * bF_A
  8.     }
  9. 
.     return scalar d_EF       = d_EF
 10.     return scalar bF_serialA = bF_A
 11.     return scalar bE_serialA = bE_A
 12.     return scalar serialA_total = (aE1+aE2+aE3+aE4+aE5+aE6+aE7) * d_EF * bF_A
 13. end

. 
. bootstrap ///
>     serialA_pc1=r(serialA_pc1) serialA_pc2=r(serialA_pc2) serialA_pc3=r(serialA_pc3) ///
>     serialA_pc4=r(serialA_pc4) serialA_pc5=r(serialA_pc5) serialA_pc6=r(serialA_pc6) ///
>     serialA_pc7=r(serialA_pc7) ///
>     d_EF=r(d_EF) bE_serialA=r(bE_serialA) bF_serialA=r(bF_serialA) ///
>     serialA_total=r(serialA_total), ///
>     reps(2000) seed(42): serial_A
