. *==============================================================================
. * Part 3. Parallel Bootstrap - 14 间接 + 总效应 + 强弱比较 (Table 4)
. *==============================================================================
. use "data_anonymized/product_master.dta", clear

. global X "z_pc1_s z_pc2_s z_pc3_s z_pc4_s z_pc5_s z_pc6_s z_pc7_s"

. global ME "m_e_avg_s"

. global MF "m_f_avg_s"

. global Y "y_50_50_s"

. global CTRL "lnprice_s lnreviews_s"

. 
. capture program drop med_parallel

. program med_parallel, rclass
  1.     sem ($ME <- $X $CTRL) ///
>         ($MF <- $X $CTRL) ///
>         ($Y  <- $X $ME $MF $CTRL)
  2. 
.     * a-paths (7 PC × 2 mediators)
.     forvalues i = 1/7 {
  3.         scalar aE`i' = _b[$ME:z_pc`i'_s]
  4.         scalar aF`i' = _b[$MF:z_pc`i'_s]
  5.     }
  6.     * b-paths
.     scalar bE = _b[$Y:$ME]
  7.     scalar bF = _b[$Y:$MF]
  8. 
.     * 14 个 indirect
.     forvalues i = 1/7 {
  9.         return scalar indE_pc`i' = aE`i' * bE
 10.         return scalar indF_pc`i' = aF`i' * bF
 11.     }
 12. 
.     * 总绝对效应 + diff(论文 "感性是否真的强过功能" 的统计检验)
.     scalar tE = abs(aE1*bE)+abs(aE2*bE)+abs(aE3*bE)+abs(aE4*bE)+abs(aE5*bE)+abs(aE6*bE)+abs(aE7*bE)
 13.     scalar tF = abs(aF1*bF)+abs(aF2*bF)+abs(aF3*bF)+abs(aF4*bF)+abs(aF5*bF)+abs(aF6*bF)+abs(aF7*bF)
 14.     return scalar totE_abs = tE
 15.     return scalar totF_abs = tF
 16.     return scalar diff_EF  = tE - tF
 17. 
.     return scalar bE = bE
 18.     return scalar bF = bF
 19. end

. 
. bootstrap ///
>     indE_pc1=r(indE_pc1) indE_pc2=r(indE_pc2) indE_pc3=r(indE_pc3) ///
>     indE_pc4=r(indE_pc4) indE_pc5=r(indE_pc5) indE_pc6=r(indE_pc6) indE_pc7=r(indE_pc7) ///
>     indF_pc1=r(indF_pc1) indF_pc2=r(indF_pc2) indF_pc3=r(indF_pc3) ///
>     indF_pc4=r(indF_pc4) indF_pc5=r(indF_pc5) indF_pc6=r(indF_pc6) indF_pc7=r(indF_pc7) ///
>     bE=r(bE) bF=r(bF) ///
>     totE_abs=r(totE_abs) totF_abs=r(totF_abs) diff_EF=r(diff_EF), ///
>     reps(5000) seed(42): med_parallel
(running med_parallel on estimation sample)

